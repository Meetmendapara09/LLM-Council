# Copy to .env and fill in real values.
# OPENROUTER_API_KEY is required by the backend (read at import time).

# OpenRouter API key (required) - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Conversation memory mode: "local" (on-device heuristic summarizer) or "model" (LLM summarizer)
MEMORY_MODE=local

# Max sentences kept in the local-memory summary
MEMORY_LOCAL_MAX_SENTENCES=3
